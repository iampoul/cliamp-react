#!/usr/bin/env bash
# Small helper for the cliamp-react user service and its Omarchy bar plugin.
set -euo pipefail

PLUGIN_ID="io.github.iampoul.cliamp-react"
STATE_FILE="$HOME/.config/cliamp-react/previous-bar-background"

bar_on() {
  command -v omarchy >/dev/null || { echo "omarchy not found" >&2; exit 1; }
  omarchy plugin enable "$PLUGIN_ID" --section centerBegin
  omarchy bar background glassy
  omarchy restart shell
  echo "bar visualizer on (background: glassy)"
}

bar_off() {
  command -v omarchy >/dev/null || { echo "omarchy not found" >&2; exit 1; }
  omarchy plugin disable "$PLUGIN_ID" || true
  previous="opaque"
  [[ -f "$STATE_FILE" ]] && previous="$(cat "$STATE_FILE")"
  omarchy bar background "$previous"
  omarchy restart shell
  echo "bar visualizer off (background restored to $previous)"
}

bar_status() {
  if command -v omarchy >/dev/null; then
    omarchy plugin list --json 2>/dev/null |
      jq -r --arg id "$PLUGIN_ID" '.[] | select(.id == $id) | "plugin: \(.id) enabled=\(.enabled)"' || true
    jq -r '"bar background: \(.bar.background // "opaque")"' \
      "$HOME/.config/omarchy/shell.json" 2>/dev/null || true
  fi
  systemctl --user is-active cliamp-react.service
}

case "${1:-status}" in
  start)     systemctl --user start cliamp-react.service ;;
  stop)      systemctl --user stop cliamp-react.service ;;
  restart)   systemctl --user restart cliamp-react.service ;;
  reload)    systemctl --user kill -s USR1 cliamp-react.service ;;
  enable)    systemctl --user enable --now cliamp-react.service ;;
  disable)   systemctl --user disable --now cliamp-react.service ;;
  status)    systemctl --user status cliamp-react.service ;;
  log)       journalctl --user -u cliamp-react.service -n 40 --no-pager ;;
  bar)
    case "${2:-status}" in
      on)     bar_on ;;
      off)    bar_off ;;
      status) bar_status ;;
      *)      echo "usage: cliamp-react-ctl bar {on|off|status}" >&2; exit 2 ;;
    esac
    ;;
  *)         echo "usage: cliamp-react-ctl {start|stop|restart|reload|enable|disable|status|log|bar on|bar off|bar status}" >&2
             exit 2 ;;
esac
