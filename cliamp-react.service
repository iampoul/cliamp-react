[Unit]
Description=cliamp-react — music-reactive Hyprland window borders
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cliamp-react
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=6
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target
