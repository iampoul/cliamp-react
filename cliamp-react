#!/usr/bin/env python3
"""cliamp-react — drive Hyprland's window border gradients from cliamp's spectrum.

Reads cliamp's V2 IPC (`spectrum.get`) and repaints the active border as a
gradient whose bright stop sits along the bottom edge of the windows. The
angle, brightness and colour mix oscillate with the low end and the beat.

No separate visualizer surface: this only changes the borders of real windows.
When cliamp goes quiet the theme's own border is restored by re-running its
generated hyprland.lua through Hyprland's Lua evaluator.
"""

from __future__ import annotations

import glob
import json
import logging
import math
import os
import signal
import socket
import subprocess
import sys
import tempfile
import time
import tomllib
from collections import deque
from pathlib import Path

HOME = Path.home()
RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
THEME_DIR = HOME / ".local/state/omarchy/current/theme"
THEME_HYPRLAND = THEME_DIR / "hyprland.lua"
THEME_COLORS = THEME_DIR / "colors.toml"
DEFAULT_CONFIG_PATH = HOME / ".config/cliamp-react/config.toml"
OVERRIDES_FILENAME = "overrides.toml"

DEFAULTS = {
    "source": {"fps": 30},
    "border": {
        "enabled": True,
        "fps": 20,
        "mode": "all",
        "angle": 120.0,
        "sweep": 30.0,
        "spin": 0.20,
        "min_alpha": 200,
        "idle_after": 0.9,
        "fade_ms": 500,
    },
    "debug": {"log_level": "info"},
}

# Exposed through `cliamp-react-ctl set`, written to overrides.toml.
# key -> (toml section, toml field, value kind)
SETTINGS = {
    "enabled": ("border", "enabled", "bool"),
    "mode": ("border", "mode", "mode"),
    "fps": ("border", "fps", "int"),
    "spin": ("border", "spin", "float"),
    "sweep": ("border", "sweep", "float"),
    "min_alpha": ("border", "min_alpha", "int"),
}

RANGES = {
    "fps": (1, 60),
    "spin": (0.0, 2.0),
    "sweep": (0.0, 90.0),
    "min_alpha": (0, 255),
}

# Motion presets: the four knobs that make the effect calmer or wilder.
# Mode stays a separate setting.
PRESETS = {
    "calm": {"spin": 0.08, "sweep": 15.0, "min_alpha": 150, "fps": 15},
    "balanced": {"spin": 0.20, "sweep": 30.0, "min_alpha": 200, "fps": 20},
    "wild": {"spin": 0.45, "sweep": 45.0, "min_alpha": 235, "fps": 30},
}
PRESET_KEYS = ("spin", "sweep", "min_alpha", "fps")

log = logging.getLogger("cliamp-react")


class SettingError(ValueError):
    """A bad setting name or value passed to the settings CLI."""


def deep_merge(base: dict, extra: dict) -> dict:
    out = dict(base)
    for key, value in (extra or {}).items():
        if isinstance(value, dict) and isinstance(out.get(key), dict):
            out[key] = deep_merge(out[key], value)
        else:
            out[key] = value
    return out


def read_toml(path: Path, *, label: str, warn_missing: bool = False) -> dict:
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle)
    except FileNotFoundError:
        if warn_missing:
            log.warning("%s %s missing, using defaults", label, path)
        return {}
    except (OSError, tomllib.TOMLDecodeError) as exc:
        log.error("%s %s unreadable (%s), ignoring it", label, path, exc)
        return {}


def overrides_path(config_path: Path) -> Path:
    """Overrides live next to the active config file."""
    return config_path.with_name(OVERRIDES_FILENAME)


def load_config(path: Path) -> dict:
    user = read_toml(path, label="config", warn_missing=True)
    overrides = read_toml(overrides_path(path), label="overrides")
    return deep_merge(deep_merge(DEFAULTS, user), overrides)


# --- settings CLI ---------------------------------------------------------


def coerce_setting(key: str, raw: str):
    if key not in SETTINGS:
        allowed = ", ".join(sorted(SETTINGS))
        raise SettingError(f"unknown setting '{key}' (expected one of: {allowed})")
    _section, _field, kind = SETTINGS[key]
    text = str(raw).strip()

    if kind == "bool":
        lowered = text.lower()
        if lowered in ("1", "true", "on", "yes"):
            return True
        if lowered in ("0", "false", "off", "no"):
            return False
        raise SettingError(f"enabled expects true/false, got '{raw}'")

    if kind == "mode":
        lowered = text.lower()
        if lowered not in ("all", "bottom"):
            raise SettingError(f"mode expects 'all' or 'bottom', got '{raw}'")
        return lowered

    if kind == "int":
        try:
            value = int(text)
        except ValueError:
            raise SettingError(f"{key} expects an integer, got '{raw}'") from None
    else:
        try:
            value = float(text)
        except ValueError:
            raise SettingError(f"{key} expects a number, got '{raw}'") from None

    low, high = RANGES[key]
    if not low <= value <= high:
        raise SettingError(f"{key} must be between {low:g} and {high:g}, got '{raw}'")
    return value


def toml_value(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        return f"{value:g}"
    if isinstance(value, str):
        return json.dumps(value)  # TOML basic string
    raise SettingError(f"cannot write {type(value).__name__} to overrides.toml")


def dump_overrides(data: dict) -> str:
    """Serialize the flat section/scalar shape overrides.toml uses."""
    lines = ["# Managed by cliamp-react-ctl; overrides config.toml. Delete a line to inherit."]
    for key, value in data.items():
        if not isinstance(value, dict):
            lines.append(f"{key} = {toml_value(value)}")
    for section, values in data.items():
        if not isinstance(values, dict):
            continue
        lines.append("")
        lines.append(f"[{section}]")
        for key, value in values.items():
            if isinstance(value, dict):
                continue
            lines.append(f"{key} = {toml_value(value)}")
    return "\n".join(lines) + "\n"


def write_overrides(path: Path, data: dict) -> None:
    text = dump_overrides(data)
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temp_path = tempfile.mkstemp(prefix=".overrides.", dir=str(path.parent))
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(text)
        os.chmod(temp_path, 0o644)
        os.replace(temp_path, path)
    except BaseException:
        try:
            os.unlink(temp_path)
        except OSError:
            pass
        raise


def _systemctl(*args: str) -> subprocess.CompletedProcess | None:
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", str(RUNTIME_DIR))
    try:
        return subprocess.run(
            ["systemctl", "--user", *args],
            capture_output=True,
            text=True,
            timeout=3,
            env=env,
        )
    except (OSError, subprocess.SubprocessError):
        return None


def service_active() -> bool | None:
    result = _systemctl("is-active", "cliamp-react.service")
    if result is None:
        return None
    return result.stdout.strip() == "active"


def signal_daemon() -> bool:
    """Ask the running service to re-read config + overrides. Inactive is fine."""
    result = _systemctl("kill", "-s", "USR1", "cliamp-react.service")
    return result is not None and result.returncode == 0


def detect_preset(config: dict, raw_overrides: dict) -> str:
    border = config["border"]
    overridden = raw_overrides.get("border") or {}
    if not any(key in overridden for key in PRESET_KEYS):
        return "config"
    for name, values in PRESETS.items():
        if all(
            abs(float(border[key]) - float(values[key])) < 1e-9
            for key in PRESET_KEYS
        ):
            return name
    return "custom"


def settings_snapshot(config_path: Path) -> dict:
    config = load_config(config_path)
    raw_overrides = read_toml(overrides_path(config_path), label="overrides")
    border = config["border"]
    effective = {key: border[field] for key, (_section, field, _kind) in SETTINGS.items()}
    effective.update(
        {
            "angle": border["angle"],
            "idle_after": border["idle_after"],
            "fade_ms": border["fade_ms"],
            "source_fps": config["source"]["fps"],
        }
    )
    active_overrides = {}
    for key, (section, field, _kind) in SETTINGS.items():
        if field in (raw_overrides.get(section) or {}):
            active_overrides[key] = raw_overrides[section][field]
    return {
        "ok": True,
        "paths": {
            "config": str(config_path),
            "overrides": str(overrides_path(config_path)),
        },
        "effective": effective,
        "overrides": active_overrides,
        "preset": detect_preset(config, raw_overrides),
        "presets": PRESETS,
        "service_active": service_active(),
    }


def settings_main(args: list[str], config_path: Path) -> int:
    if not args:
        print(
            "usage: cliamp-react settings {get|set <key> <value>|preset <name>|reset}",
            file=sys.stderr,
        )
        return 2
    verb = args[0]
    path = overrides_path(config_path)
    try:
        if verb == "get":
            snapshot = settings_snapshot(config_path)
        elif verb == "set":
            if len(args) != 3:
                raise SettingError("usage: cliamp-react settings set <key> <value>")
            key, raw = args[1], args[2]
            value = coerce_setting(key, raw)
            section, field, _kind = SETTINGS[key]
            data = read_toml(path, label="overrides")
            data.setdefault(section, {})[field] = value
            write_overrides(path, data)
            signal_daemon()
            snapshot = settings_snapshot(config_path)
        elif verb == "preset":
            if len(args) != 2:
                raise SettingError(
                    "usage: cliamp-react settings preset " + "|".join(PRESETS)
                )
            name = args[1].strip().lower()
            if name not in PRESETS:
                raise SettingError(
                    f"unknown preset '{args[1]}' (expected: {', '.join(PRESETS)})"
                )
            data = read_toml(path, label="overrides")
            data.setdefault("border", {}).update(PRESETS[name])
            write_overrides(path, data)
            signal_daemon()
            snapshot = settings_snapshot(config_path)
        elif verb == "reset":
            try:
                path.unlink()
            except FileNotFoundError:
                pass
            signal_daemon()
            snapshot = settings_snapshot(config_path)
        else:
            raise SettingError(f"unknown settings command '{verb}'")
    except SettingError as exc:
        print(f"cliamp-react: {exc}", file=sys.stderr)
        return 2
    except OSError as exc:
        print(f"cliamp-react: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(snapshot, indent=2))
    return 0


# --- colour helpers -------------------------------------------------------


def parse_hex(value: str, fallback: tuple[int, int, int]) -> tuple[int, int, int]:
    text = str(value or "").strip().lstrip("#")
    if len(text) == 8:
        text = text[:6]
    if len(text) != 6:
        return fallback
    try:
        return tuple(int(text[i : i + 2], 16) for i in (0, 2, 4))  # type: ignore[return-value]
    except ValueError:
        return fallback


def mix(a, b, t: float):
    t = max(0.0, min(1.0, t))
    return tuple(a[i] + (b[i] - a[i]) * t for i in range(3))


def rgba(color, alpha: int) -> str:
    r, g, b = (max(0, min(255, int(round(c)))) for c in color)
    return f"rgba({r:02x}{g:02x}{b:02x}{max(0, min(255, alpha)):02x})"


class Palette:
    """Accent colours of the active Omarchy theme."""

    def __init__(self) -> None:
        self.accent = (122, 162, 247)
        self.hot = (173, 142, 230)
        self.reload()

    def reload(self) -> None:
        try:
            with THEME_COLORS.open("rb") as handle:
                data = tomllib.load(handle)
        except (OSError, tomllib.TOMLDecodeError) as exc:
            log.warning("theme colours unavailable (%s)", exc)
            return
        self.accent = parse_hex(data.get("accent", "#7aa2f7"), self.accent)
        self.hot = parse_hex(
            data.get("bright_red")
            or data.get("red")
            or data.get("magenta")
            or "#f7768e",
            self.hot,
        )
        log.info("palette: accent=#%02x%02x%02x hot=#%02x%02x%02x",
                 *self.accent, *self.hot)


# --- Hyprland IPC ---------------------------------------------------------


class Hyprland:
    def __init__(self) -> None:
        self.path: Path | None = None

    def _discover(self) -> Path | None:
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if signature:
            candidate = RUNTIME_DIR / "hypr" / signature / ".socket.sock"
            if candidate.exists():
                return candidate
        sockets = glob.glob(str(RUNTIME_DIR / "hypr" / "*" / ".socket.sock"))
        return Path(max(sockets, key=os.path.getmtime)) if sockets else None

    def send(self, command: str) -> str | None:
        if self.path is None or not self.path.exists():
            self.path = self._discover()
        if self.path is None:
            return None
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(1.0)
        try:
            sock.connect(str(self.path))
            sock.sendall(command.encode() + b"\n")
            reply = sock.recv(256).decode(errors="replace").strip()
        except OSError as exc:
            log.debug("hyprland ipc failed: %s", exc)
            self.path = None
            return None
        finally:
            sock.close()
        if reply and reply.startswith("error"):
            log.warning("hyprland eval failed: %s", reply)
        elif reply not in ("ok", ""):
            log.debug("hyprland reply: %s", reply)
        return reply

    def border(self, first, second, angle: float, alpha: int = 255) -> None:
        # 120deg puts the second (bright) stop on the bottom edge of the frame.
        # Inactive windows get the same moving gradient at lower intensity, so
        # every app on the desktop pulses, not only the focused one.
        inactive_alpha = max(90, int(alpha * 0.7))
        dim_first = mix(first, (0, 0, 0), 0.32)
        dim_second = mix(second, (0, 0, 0), 0.12)

        def grad(c1, c2, a1, a2):
            return (
                '{ colors = { "'
                + rgba(c1, a1)
                + '", "'
                + rgba(c2, a2)
                + f'" }}, angle = {angle:.1f} }}'
            )

        code = (
            "hl.config({ general = { col = { active_border = "
            + grad(first, second, alpha, 255)
            + ", inactive_border = "
            + grad(dim_first, dim_second, inactive_alpha, min(255, inactive_alpha + 40))
            + " } } })"
        )
        self.send("eval " + code)

    def restore(self) -> None:
        """Re-apply the active theme's own border (exact, theme-agnostic)."""
        if not THEME_HYPRLAND.exists():
            log.warning("no %s; leaving borders as they are", THEME_HYPRLAND)
            return
        self.send(f'eval dofile("{THEME_HYPRLAND}")')
        log.info("restored theme border")


# --- cliamp spectrum ------------------------------------------------------


def cliamp_socket() -> Path:
    custom = os.environ.get("CLIAMP_CONFIG_DIR")
    if custom:
        return Path(custom).expanduser() / "cliamp.sock"
    return HOME / ".config/cliamp/cliamp.sock"


class Spectrum:
    def __init__(self, path: Path, fps: int) -> None:
        self.path = path
        self.interval = 1.0 / max(1, min(60, int(fps)))
        self.sock: socket.socket | None = None
        self.buffer = b""
        self.next_poll = 0.0
        self.next_state = 0.0
        self.serial = 0

    def close(self) -> None:
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
        self.sock = None
        self.buffer = b""

    def _connect(self) -> bool:
        if not self.path.exists():
            return False
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(0.5)
        try:
            sock.connect(str(self.path))
        except OSError:
            sock.close()
            return False
        self.sock = sock
        self.buffer = b""
        log.info("connected to %s", self.path)
        return True

    def _readline(self) -> bytes | None:
        assert self.sock is not None
        while b"\n" not in self.buffer:
            try:
                chunk = self.sock.recv(65536)
            except (socket.timeout, OSError):
                return None
            if not chunk:
                return None
            self.buffer += chunk
            if len(self.buffer) > 4 * 1024 * 1024:
                self.buffer = b""
                return None
        line, self.buffer = self.buffer.split(b"\n", 1)
        return line

    def _request(self, method: str) -> dict | None:
        self.serial += 1
        request = {
            "version": 2,
            "id": f"cliamp-react-{self.serial}",
            "method": method,
        }
        try:
            self.sock.sendall(json.dumps(request).encode() + b"\n")
        except OSError:
            self.close()
            return None
        line = self._readline()
        if line is None:
            self.close()
            return None
        try:
            message = json.loads(line)
        except json.JSONDecodeError:
            return None
        return message if message.get("ok") else None

    def poll(self, now: float) -> list[float] | None:
        if now < self.next_poll:
            return None
        self.next_poll = now + self.interval
        if self.sock is None and not self._connect():
            return None
        message = self._request("spectrum.get")
        if message is None:
            return None
        result = message.get("result") or {}
        bands = [float(value) for value in result.get("bands") or []]
        return bands or None

    def poll_state(self, now: float) -> str | None:
        """Playback state, sampled twice a second — precise pause detection."""
        if now < self.next_state:
            return None
        self.next_state = now + 0.5
        if self.sock is None and not self._connect():
            return None
        message = self._request("state.get")
        if message is None:
            return None
        snapshot = message.get("snapshot") or message.get("result") or {}
        return snapshot.get("state")


# --- dynamics -------------------------------------------------------------


def approach(current: float, target: float, dt: float, tau: float) -> float:
    if tau <= 0:
        return target
    return current + (target - current) * (1.0 - math.exp(-dt / tau))


class Dynamics:
    """Band analysis with an asymmetric envelope and a simple beat detector."""

    def __init__(self, cfg: dict) -> None:
        self.cfg = cfg
        self.env = 0.0
        self.bass = 0.0
        self.high = 0.0
        self.pulse = 0.0
        self.kick = 0.0
        self.phase = 0.0
        self.osc_phase = 0.0
        self.angle = float(cfg["angle"])
        self.history: deque[float] = deque(maxlen=90)
        self.last_beat = 0.0
        self.last_sound = time.monotonic()

    def update(self, bands: list[float], now: float, dt: float) -> None:
        count = len(bands)
        third = max(1, count // 3)
        bass = sum(bands[:third]) / third
        mid = sum(bands[third : 2 * third]) / max(1, third)
        high = sum(bands[2 * third :]) / max(1, count - 2 * third)
        energy = 0.6 * bass + 0.28 * mid + 0.12 * high

        # fast attack, slow release
        self.env = approach(
            self.env, energy, dt, 0.035 if energy > self.env else 0.19
        )
        self.bass = approach(self.bass, bass, dt, 0.05)
        self.high = approach(self.high, high, dt, 0.08)

        self.history.append(bass)
        average = sum(self.history) / len(self.history)
        beat = (
            bass > 0.11
            and bass > average * 1.35
            and now - self.last_beat > 0.13
        )
        if beat:
            self.last_beat = now
            self.pulse = min(1.0, 0.35 + bass * 1.4)
            self.kick = min(1.0, bass * 1.3)
        self.pulse *= math.exp(-dt / 0.22)
        self.kick *= math.exp(-dt / 0.28)

        if energy > 0.012:
            self.last_sound = now

        # Oscillate the gradient around the bottom-anchored angle: faster and
        # wider when loud, with a kick on the beat. No full rotation, so the
        # bright stop stays on the lower edge of the windows.
        self.osc_phase += dt * (0.6 + 1.9 * self.env)
        # "all"  — the gradient travels around all four edges of every window,
        #          spinning faster when the music is louder, with a beat kick.
        # "bottom" — the bright stop stays on the bottom edge and slides along it.
        if self.cfg.get("mode", "all") == "bottom":
            self.phase += dt * (0.35 + 1.7 * self.env)
            self.angle = (
                self.cfg["angle"]
                + 0.5 * self.cfg["sweep"] * math.sin(self.phase * math.tau)
            ) % 360.0
        else:
            self.phase += dt * (0.02 + float(self.cfg.get("spin", 0.20)) * self.env)
            self.angle = (
                360.0 * self.phase + self.cfg["sweep"] * self.kick
            ) % 360.0

    def colours(self, palette: Palette, fade: float):
        """fade 1.0 = live, 0.0 = theme accent."""
        oscillation = 0.5 + 0.5 * math.sin(self.osc_phase * math.tau)
        # First stop: the theme accent, gently brightened by the beat.
        live_first = mix(
            palette.accent, (255, 255, 255), 0.03 + 0.22 * self.env * oscillation
        )
        # Second stop: the hot accent, the one that lands on the bottom edge.
        live_second = mix(
            palette.accent,
            palette.hot,
            0.35 + 0.60 * min(1.0, self.bass * (0.55 + 0.65 * oscillation)),
        )
        first = mix(palette.accent, live_first, fade)
        second = mix(palette.accent, live_second, fade)
        alpha = int(
            self.cfg["min_alpha"]
            + (255 - self.cfg["min_alpha"])
            * (0.45 * self.env * oscillation + 0.40 * self.pulse + 0.15 * self.kick)
        )
        return first, second, alpha


# --- daemon ---------------------------------------------------------------


class Daemon:
    def __init__(self, config_path: Path, debug: bool = False):
        self.config_path = config_path
        self.config = load_config(config_path)
        if debug:
            self.config["debug"]["log_level"] = "debug"
        self.palette = Palette()
        self.hypr = Hyprland()
        self.spec = Spectrum(cliamp_socket(), self.config["source"]["fps"])
        self.dyn = Dynamics(self.config["border"])

        self.state = "idle"  # live | fading | idle
        self.fade_start = 0.0
        self.fade = 1.0
        self.border_interval = 1.0 / max(1, min(60, int(self.config["border"]["fps"])))
        self.next_border = 0.0
        self.playing = False
        self.playing_known = False
        self.running = True

    def stop(self, *_args) -> None:
        self.running = False

    def reload(self, *_args) -> None:
        log.info("reloading config and palette")
        self.config = load_config(self.config_path)
        self.palette.reload()
        self.dyn.cfg = self.config["border"]
        self.dyn.angle = (
            float(self.config["border"]["angle"])
            if self.config["border"].get("mode", "all") == "bottom"
            else 0.0
        )
        self.border_interval = 1.0 / max(
            1, min(60, int(self.config["border"]["fps"]))
        )
        if not self.config["border"]["enabled"]:
            # Turning the effect off must put the theme's own border back now,
            # not leave the last gradient frame on screen.
            self.state = "idle"
            self.fade = 0.0
            self.hypr.restore()

    def run(self) -> int:
        signal.signal(signal.SIGTERM, self.stop)
        signal.signal(signal.SIGINT, self.stop)
        signal.signal(signal.SIGUSR1, self.reload)

        log.info(
            "up: borders=%s @%.0f fps, source=%.0f fps",
            "on" if self.config["border"]["enabled"] else "off",
            self.config["border"]["fps"],
            self.config["source"]["fps"],
        )
        self.hypr.restore()
        self.dyn.last_sound = time.monotonic() - 10.0

        last = time.monotonic()
        last_band = last
        try:
            while self.running:
                now = time.monotonic()
                dt = max(0.0, min(0.25, now - last))
                last = now

                bands = self.spec.poll(now)
                if bands:
                    # dt between spectrum frames, not between loop spins:
                    # the loop itself ticks every few milliseconds.
                    dt_band = max(0.0, min(0.25, now - last_band))
                    last_band = now
                    self.dyn.update(bands, now, dt_band)

                state = self.spec.poll_state(now)
                if state is not None:
                    self.playing = state == "playing"
                    self.playing_known = True
                elif not cliamp_socket().exists():
                    self.playing = False

                self.tick_state(now)
                if now >= self.next_border:
                    self.next_border = now + self.border_interval
                    self.push_border()
                time.sleep(0.004)
        finally:
            self.spec.close()
            self.hypr.restore()
            log.info("shutting down")
        return 0

    def tick_state(self, now: float) -> None:
        cfg = self.config["border"]
        active = (
            self.playing
            if self.playing_known
            else now - self.dyn.last_sound < cfg["idle_after"]
        )
        if active:
            self.dyn.last_sound = now
            if self.state != "live":
                log.info("music detected, borders live")
            self.state = "live"
            self.fade = 1.0
            return
        if self.state == "live":
            self.state = "fading"
            self.fade_start = now
        if self.state == "fading":
            span = max(0.05, cfg["fade_ms"] / 1000.0)
            self.fade = max(0.0, 1.0 - (now - self.fade_start) / span)
            if self.fade <= 0.0:
                self.state = "idle"
                self.hypr.restore()

    def push_border(self) -> None:
        if not self.config["border"]["enabled"] or self.state == "idle":
            return
        first, second, alpha = self.dyn.colours(self.palette, self.fade)
        if self.config["border"].get("mode", "all") == "bottom":
            base = self.config["border"]["angle"]
            angle = base + (
                (self.dyn.angle - base + 180) % 360 - 180
            ) * self.fade
        else:
            angle = self.dyn.angle
        # Fade alpha back to opaque so the final restore never pops.
        alpha = int(alpha + (255 - alpha) * (1.0 - self.fade))
        self.hypr.border(first, second, angle % 360.0, alpha)
        if log.isEnabledFor(logging.DEBUG):
            log.debug(
                "env=%.2f bass=%.2f pulse=%.2f angle=%.0f fade=%.2f",
                self.dyn.env,
                self.dyn.bass,
                self.dyn.pulse,
                angle,
                self.fade,
            )


def parse_args(argv: list[str]) -> tuple[bool, Path, list[str]]:
    debug = False
    config_path = DEFAULT_CONFIG_PATH
    rest: list[str] = []
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg in ("--debug", "-d"):
            debug = True
            index += 1
        elif arg == "--config" and index + 1 < len(argv):
            config_path = Path(argv[index + 1]).expanduser()
            index += 2
        else:
            rest.append(arg)
            index += 1
    return debug, config_path, rest


def main(argv: list[str]) -> int:
    debug, config_path, rest = parse_args(argv)
    if rest[:1] == ["settings"]:
        return settings_main(rest[1:], config_path)

    config = load_config(config_path)
    level = logging.DEBUG if debug else getattr(
        logging, str(config["debug"]["log_level"]).upper(), logging.INFO
    )
    logging.basicConfig(
        level=level,
        format="%(asctime)s %(levelname)s %(message)s",
        datefmt="%H:%M:%S",
    )
    return Daemon(config_path, debug=debug).run()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
